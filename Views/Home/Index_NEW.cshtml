@{
    ViewData["Title"] = "BHYT Dashboard - Trang Chủ";
    Layout = "_LandingLayout";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body, html {
        width: 100%;
        height: 100%;
    }

    .landing-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-image: url('https://cdn-healthcare.hellohealthgroup.com/2022/04/1649844649_6256a1a9c7f1a5.73204135.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        position: relative;
        padding: 2rem;
    }

    .landing-container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.4);
        z-index: 1;
    }

    .landing-content {
        text-align: center;
        max-width: 600px;
        position: relative;
        z-index: 2;
        animation: fadeIn 0.8s ease-out;
    }

    .landing-logo {
        margin-bottom: 3rem;
        animation: slideDown 0.8s ease-out;
    }

    .landing-logo img {
        max-width: 300px;
        height: auto;
        filter: drop-shadow(0 15px 35px rgba(0, 0, 0, 0.3));
    }

    .landing-title {
        font-size: 3rem;
        font-weight: 800;
        color: white;
        margin-bottom: 1.5rem;
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.4);
        animation: slideUp 0.8s ease-out 0.2s both;
        letter-spacing: 1px;
    }

    .landing-subtitle {
        font-size: 1.3rem;
        color: #e0e7ff;
        margin-bottom: 4rem;
        line-height: 1.8;
        animation: slideUp 0.8s ease-out 0.4s both;
        text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.3);
    }

    .dashboard-button {
        display: inline-block;
        padding: 1.2rem 4rem;
        font-size: 1.3rem;
        font-weight: 700;
        color: white;
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        border: none;
        border-radius: 50px;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 15px 40px rgba(220, 38, 38, 0.4);
        animation: slideUp 0.8s ease-out 0.6s both;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 1px;
        position: relative;
        overflow: hidden;
    }

    .dashboard-button::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        background: rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        transform: translate(-50%, -50%);
        transition: width 0.6s, height 0.6s;
    }

    .dashboard-button:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 50px rgba(220, 38, 38, 0.6);
        background: linear-gradient(135deg, #b91c1c 0%, #991b1b 100%);
    }

    .dashboard-button:hover::before {
        width: 300px;
        height: 300px;
    }

    .dashboard-button:active {
        transform: translateY(-2px);
    }

    .dashboard-button span {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Mobile responsiveness */
    media (max-width: 768px) {
        .landing-container {
            padding: 1rem;
            background-attachment: scroll;
        }

        .landing-title {
            font-size: 2rem;
        }

        .landing-subtitle {
            font-size: 1.1rem;
            margin-bottom: 2.5rem;
        }

        .landing-logo img {
            max-width: 200px;
        }

        .dashboard-button {
            padding: 0.9rem 2.5rem;
            font-size: 1.1rem;
        }
    }

    media (max-width: 480px) {
        .landing-container {
            padding: 1rem 0.5rem;
        }

        .landing-title {
            font-size: 1.6rem;
            margin-bottom: 1rem;
        }

        .landing-subtitle {
            font-size: 0.95rem;
            margin-bottom: 2rem;
        }

        .landing-logo {
            margin-bottom: 2rem;
        }

        .landing-logo img {
            max-width: 150px;
        }

        .dashboard-button {
            padding: 0.8rem 2rem;
            font-size: 1rem;
            width: 100%;
        }
    }
</style>

<div class="landing-container">
    <div class="landing-content">
        <!-- Logo/Image -->
        <div class="landing-logo">
            <img src="https://cdn-healthcare.hellohealthgroup.com/2022/04/1649844649_6256a1a9c7f1a5.73204135.jpg" 
                 alt="Bệnh Viện Ung Bướu BHYT" />
        </div>

        <!-- Title -->
        <h1 class="landing-title">BHYT Dashboard</h1>

        <!-- Subtitle -->
        <p class="landing-subtitle">
            Hệ thống quản lý và báo cáo chi phí khám chữa bệnh bảo hiểm y tế<br/>
            Theo dõi dữ liệu trong thời gian thực
        </p>

        <!-- Dashboard Button -->
        <a href="@Url.Action("Index", "Dashboard")" class="dashboard-button">
            <span>
                <i class="bi bi-speedometer2"></i>
                DASHBOARD BHYT
            </span>
        </a>
    </div>
</div>
